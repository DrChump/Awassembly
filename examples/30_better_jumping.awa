; jump to address on stack
; RULE: there can never be a non-magic number lower than -127 on the stack
; -----VARIABLES BELOW-----
blo 0 ; game state
; -----VARIABLES ABOVE-----
blo 0 ; return address
blo -128 ; magic number
blo 0 ; garbage
blo 0 ; garbage

jmp 2 ; jump to entry point

lbl 0 ; jump to return address [2,31] just below magic number
; stack looks like this
; garbage
; magic number
; return address
; other stuff

; goto magic number
blo 0 ; garbage
blo 0 ; garbage
lbl 1
pop
pop

; empty double bubbles are hard to detect, don't know what to do about that
; 'red' with no user input creates some sort of empty double bubble, I think
cnt ; check for double bubble
blo 0
lss
pop
pop
pop

blo -128
lss
jmp 1
pop ; -128

; stack looks like this
; magic number
; return address
; other stuff

; copy return address over
OVER 1

; stack looks like this
; return address (copy)
; magic number
; return address
; other stuff

; jump to return address [2,31]
; must pop twice after every label
REPEAT 2 31
    blo ITERATOR
    eql
    jmp ITERATOR
    pop
END
PRINT "ERROR: tried to jump to a label that doesn\'t exist\n"
PRINT "ERROR: label: "
pr1
trm

; -------------------CODE GOES BELOW--------------------

lbl 2 ; entry point
pop ; mandatory
pop ; mandatory
PRINT "This is the start\n"
;
; stack looks like this
; magic number
; return address
; game state
;
; goto 3
sbm 1
pop
blo 3
sbm 1
jmp 0

lbl 3 ; middle
pop ; mandatory
pop ; mandatory
PRINT "This is the middle\n"
;
; stack looks like this
; magic number
; return address
; game state
;
; increment game state and calculate return address from game state
; address = state * 2
; start -> middle -> start -> middle -> end
sbm 2
pop
blo 1
4dd
dpl
sbm 2
blo 2
mul
sbm 1
jmp 0

lbl 4 ; end
pop ; mandatory
pop ; mandatory
PRINT "This is the end\n"
trm
