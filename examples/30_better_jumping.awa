; -------------------CODE GOES BELOW--------------------

lbl 2 ; entry point
pop ; mandatory
pop ; mandatory
PRINT "This is the start\n"
;
; stack looks like this
; magic number
; return address
; game state
;
; goto 3
sbm 1
pop
blo 3
sbm 1
jmp 0

lbl 3 ; middle
pop ; mandatory
pop ; mandatory
PRINT "This is the middle\n"
;
; stack looks like this
; magic number
; return address
; game state
;
; increment game state and calculate return address from game state
; address = state * 2
; start -> middle -> start -> middle -> end
sbm 2
pop
blo 1
4dd
dpl
sbm 2
blo 2
mul
sbm 1
jmp 0

lbl 4 ; end
pop ; mandatory
pop ; mandatory
PRINT "This is the end\n"
trm
