; tictactoe
; RULE: there can never be a non-magic number lower than -127 on the stack
; -----VARIABLES BELOW-----
; active player
; 1 : player 1 is playing
; -1: player 2 is playing
blo 1
; game board
blo 0 blo 0 blo 0
blo 0 blo 0 blo 0
blo 0 blo 0 blo 0
; -----VARIABLES ABOVE-----
blo 0 ; return address
blo -128 ; magic number
blo 0 ; garbage
blo 0 ; garbage

jmp 2 ; jump to entry point

lbl 0 ; jump to return address [2,31] just below magic number
; stack looks like this
; garbage
; magic number
; return address
; other stuff

; goto magic number
blo 0 ; garbage
blo 0 ; garbage
lbl 1
pop
pop

; empty double bubbles are hard to detect, don't know what to do about that
; 'red' with no user input creates some sort of empty double bubble, I think
cnt ; check for double bubble
blo 0
lss
pop
pop
pop

blo -128
lss
jmp 1
pop ; -128

; stack looks like this
; magic number
; return address
; other stuff

; copy return address over
OVER 1

; stack looks like this
; return address (copy)
; magic number
; return address
; other stuff

; jump to return address [2,31]
; must pop twice after every label
REPEAT 2 31
    blo ITERATOR
    eql
    jmp ITERATOR
    pop
END
PRINT "ERROR: tried to jump to a label that doesn\'t exist\n"
PRINT "ERROR: label: "
pr1
trm

; -------------------CODE GOES BELOW--------------------

lbl 2 ; entry point
pop ; mandatory
pop ; mandatory
PRINT "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
PRINT "Let\'s play a game of TicTacToe!\n"
PRINT "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
;
; stack looks like this
; magic number
; return address
; game state
;
; goto 3
sbm 1
pop
blo 3 ; print game state
sbm 1
jmp 0

lbl 5 ; ask for user input
pop ; mandatory
pop ; mandatory
; check the active player
OVER 11
; stack looks like this
; active player (copy)
; magic number
; other
PRINT "Player "
; f(1)=1
; f(-1)=2
; f(x)=(1 - x)/2 + 1
blo 1
sub
blo 2
sbm 1
div
pop
sbm 1
pop ; remainder
blo 1
4dd
; stack looks like this
; player number
; active player
; magic number
; other
blo '0'
4dd
prn
PRINT ", select a square (1 to 9). Make sure to only type a single character\n"
red
; stack looks like this
; double bubble user input
; magic number
; return address
; other
sbm 2
sbm 2
pop
blo 7 ; input validation
sbm 2
cnt
sbm 1
sbm 3
; stack looks like this
; count (should be 1 if input valid)
; magic number
; return address
; double bubble user input
; other
blo 1
eql
jmp 0 ; input validation
pop ; 1
pop ; count
sbm 2
pop
blo 6 ; wrong input
sbm 2
; stack looks like this
; double bubble user input
; magic number
; return address
; other
pop ; input double bubble
jmp 0 ; wrong input

lbl 6 ; wrong input
pop ; mandatory
pop ; mandatory
PRINT "\nInvalid input, try again\n"
sbm 1
pop
blo 3 ; print game state
sbm 1
jmp 0

lbl 7 ; input validation
pop ; mandatory
pop ; mandatory
; stack looks like this
; magic number
; return address
; double bubble user input with only 1 character
; other
sbm 2
sbm 2
pop ; input double bubble
; stack looks like this
; input char
; magic number
; return address
; other
sbm 2
sbm 2
pop ; return address
blo 6 ; wrong input
sbm 2
; stack looks like this
; input char
; magic number
; return address
; other
; check if input char is number between 1 and 9
blo '1'
gr8
jmp 0 ; wrong input
pop
blo '9'
lss
jmp 0 ; wrong input
pop

; copy active player over
