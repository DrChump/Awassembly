; input char
; magic number
; return address
; game state x9
; active player
; other
OVER 12
sbm 1
; stack looks like this
; input char
; active player (copy)
; magic number
; return address
; game state x9
; active player
; other

; check if box with that number is empty
blo '0'
sbm 1
sub ; turn input from char to number
sbm 3
sbm 3
sbm 12 ; hide magic number
sbm 12 ; hide return address
; stack looks like this
; input char - '0'
; active player (copy)
; game state x9
; magic number
; return address
; active player
; other

; iterate over boxes [1,9]
blo 0 ; loop index
blo 0 ; garbage
lbl 8 ; loop
pop ; garbage
; increment loop index
blo 1
4dd
; stack looks like this
; loop index
; input char - '0'
; active player (copy)
; game state x?
; magic number
; other
; check if we are at the right box
eql
jmp 9 ; check and update box
lbl 10 ; return from 9
sbm 3 ; loop index
sbm 3 ; input char
sbm 3 ; active player
sbm 13 ; processed box
; stack looks like this
; loop index
; input char - '0'
; active player (copy)
; game state x?
; magic number
; return address
; game state x?
; game state being processed
; other
; check loop index
blo 9
gr8
jmp 8 ; loop
pop ; garbage
pop ; loop index
sbm 1 ; return value
pop ; active player (1,2)
; stack looks like this
; return value 0:good
; magic number
; return address
; other
; set return address to swap players
sbm 2
sbm 2
pop ; return address
blo 12 ; swap players
sbm 2
blo 0
eql ; if return value is 0
jmp 0 ; swap players
pop
pop ; return value
sbm 1
pop ; return address
blo 6 ; wrong input
sbm 1
jmp 0

lbl 11 ; check win condition
pop ; mandatory
pop ; mandatory
; prepare to go to game over (decisive)
sbm 1
pop
blo 13 ; game over (decisive)
sbm 1
; check all 8 win conditions
sbm 10 ; magic number
sbm 10 ; return address
blo 1 ; result of calculation
; check 123
OVER 1 ; 1
OVER 3 ; 2+1
OVER 5 ; 3+1+1
mul
mul
; stack looks like this
; gs1 * gs2 * gs3 (0,1,2,4,8)
; game state x9
; magic number
; return address
; other
