; checked every win condition

; stack looks like this
; result 0:game over
; game state x9
; magic number
; return address
; other
; rearrange the stack
sbm 9
REPEAT 1 9
    sbm 11
END
; stack looks like this
; result 0:game over
; magic number
; return address
; game state x9
; other
blo 0
eql
jmp 0 ; game decisive
pop ; garbage
pop ; result

; prepare to go to game over (draw)
sbm 1
pop
blo 14 ; game over (draw)
sbm 1
; check if empty box remains by multiplying all boxes together
sbm 10 ; magic number
sbm 10 ; return address
blo 1 ; result
REPEAT 1 9 ; repeat 9 times for all nine boxes
    sbm 1 ; swap
    dpl
    sbm 12 ; put box away
    mul ; new result
END
; if result is bigger than 0, the game is a draw
blo 0
lss
jmp 0 ; game is a draw
pop ; garbage
pop ; result

; goto 5 game is still going
sbm 1
pop
blo 5 ; ask for user input
sbm 1
jmp 0

lbl 13 ; game over (decisive)
pop ; mandatory
pop ; mandatory
PRINT "~~~~~~~~~~~~~~~~~~~~~~\n"
PRINT "Player "
OVER 11 ; copy active player over
blo -1
mul ; invert the player to get the winner
; get player number
; f(1)=1
; f(-1)=2
; f(x)=(1 - x)/2 + 1
dpl
blo 1
sub
blo 2
sbm 1
div
pop
sbm 1
pop ; remainder
blo 1
4dd
; turn it into char
blo '0'
4dd
prn
PRINT " won the game!\n"
PRINT "~~~~~~~~~~~~~~~~~~~~~~\n"
trm

