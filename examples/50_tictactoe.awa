; f(p,1)=1
; f(p,2)=2
; f(p,g)=p*((2-g)/2) + g
dpl
sbm 3
sbm 3
sbm 3
dpl
sbm 2
dpl
sbm 2
blo 2
sub
blo 2
sbm 1
div
pop
sbm 1
pop ; remainder
mul
4dd ; new game state
sbm 1
pop ; old game state

